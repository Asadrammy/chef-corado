# Database (Local Development - SQLite)
DATABASE_URL=file:./dev.db

# NextAuth (Local Development)
NEXTAUTH_SECRET=local-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Environment
NODE_ENV=development
ENVIRONMENT=development

# Stripe (Development Placeholders - Use real test keys for payment testing)
STRIPE_SECRET_KEY=sk_test_dev_placeholder_replace_with_real_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dev_placeholder_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_dev_placeholder_replace_with_real_key

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# API Configuration
API_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (Local Development)
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

