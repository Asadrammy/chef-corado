generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                  @id @default(cuid())
  name                        String
  firstName                   String?
  surname                     String?
  username                    String?                 @unique
  bio                         String?
  website                     String?
  socialProfile               String?
  image                       String?
  imageData                   String?
  email                       String                  @unique
  password                    String
  phone                       String?
  role                        String                  @default("CLIENT")
  adminRole                   String?
  adminPermissions            String?
  adminDisabledAt             DateTime?
  adminLastPermissionChangeAt DateTime?
  isBanned                    Boolean                 @default(false)
  banReason                   String?
  banAdminNotes               String?
  bannedAt                    DateTime?
  bannedBy                    String?
  verified                    Boolean                 @default(false)
  profileCompletion           Int                     @default(0)
  experienceLevel             String                  @default("BEGINNER")
  termsAcceptedAt             DateTime?
  termsVersion                String?
  acceptedVia                 String?
  resetToken                  String?                 @unique
  resetTokenExpires           DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  bookings                    Booking[]               @relation("ClientBookings")
  chefProfile                 ChefProfile?
  receivedMessages            Message[]               @relation("MessageReceiver")
  sentMessages                Message[]               @relation("MessageSender")
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  requests                    Request[]               @relation("ClientRequests")
  requestPhotos               RequestPhoto[]          @relation("RequestPhotoUploader")
  fullTimeChefEnquiries       FullTimeChefEnquiry[]
  reviews                     Review[]                @relation("ClientReviews")
  accounts                    Account[]
  sessions                    Session[]
  legalAcceptances            UserLegalAcceptance[]
  requestedGuestAmendments    BookingGuestAmendment[] @relation("GuestAmendmentRequester")

  @@index([adminRole])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChefProfile {
  id                                 String                     @id @default(cuid())
  userId                             String                     @unique
  location                           String?
  latitude                           Float?
  longitude                          Float?
  locationCity                       String?
  locationRegion                     String?
  formattedAddress                   String?
  geocodingProvider                  String?
  geocodingStatus                    String                     @default("UNVERIFIED")
  radius                             Float                      @default(50)
  baseCountryCode                    String                     @default("GB")
  preferredCurrency                  String                     @default("GBP")
  bio                                String?
  specialties                        String?
  careerStage                        String?
  cuisineTypes                       String?
  priceRange                         String?
  isApproved                         Boolean                    @default(false)
  isBanned                           Boolean                    @default(false)
  banReason                          String?
  banAdminNotes                      String?
  bannedAt                           DateTime?
  bannedBy                           String?
  profileCompletion                  Int                        @default(0)
  verificationStatus                 String                     @default("PENDING")
  certifications                     String?
  chefType                           String?
  cuisineType                        String?
  eventsPerMonth                     Int?
  experience                         Int?
  experienceLevel                    String?
  profileImage                       String?
  stripeAccountId                    String?
  stripeOnboardingComplete           Boolean?
  verified                           Boolean                    @default(false)
  rightToWorkUkConfirmed             Boolean                    @default(false)
  foodHygieneLevel2Confirmed         Boolean                    @default(false)
  foodHygieneCertificateUrl          String?
  foodHygieneCertificateUploadedAt   DateTime?
  foodHygieneCertificateReviewedAt   DateTime?
  foodHygieneCertificateReviewedBy   String?
  foodHygieneCertificateReviewStatus String?
  approvedAt                         DateTime?
  approvedBy                         String?
  reviewedAt                         DateTime?
  reviewedBy                         String?
  reviewNotes                        String?
  insuranceAcknowledgedAt            DateTime?
  insuranceVersion                   String?
  insuranceStatus                    String                     @default("pending")
  insuranceDocumentUrl               String?
  insuranceExpiryDate                DateTime?
  insuranceVerifiedAt                DateTime?
  insuranceVerifiedBy                String?
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt
  availability                       Availability[]
  bookings                           Booking[]                  @relation("ChefBookings")
  chefKpiSnapshots                   ChefKpiSnapshot[]
  user                               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences                        Experience[]
  menus                              Menu[]
  payouts                            Payout[]
  proposals                          Proposal[]
  requestInvitations                 RequestInvitation[]
  reviews                            Review[]
  backgroundChecks                   BackgroundCheck[]
  bookingInsuranceCoverages          BookingInsuranceCoverage[]

  @@index([latitude, longitude])
  @@index([isApproved])
  @@index([isBanned])
  @@index([verificationStatus])
}

model Menu {
  id          String        @id @default(cuid())
  chefId      String
  title       String
  description String?
  price       Float?
  currency    String        @default("GBP")
  menuType    String        @default("FREE_FORM")
  menuImage   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cuisineType String?
  eventType   String?
  chef        ChefProfile   @relation(fields: [chefId], references: [id])
  sections    MenuSection[]
  proposals   Proposal[]
}

model MenuSection {
  id        String     @id @default(cuid())
  menuId    String
  title     String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id            String      @id @default(cuid())
  menuSectionId String
  name          String
  description   String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  menuSection   MenuSection @relation(fields: [menuSectionId], references: [id], onDelete: Cascade)
}

model Experience {
  id                   String      @id @default(cuid())
  title                String
  description          String
  price                Float
  currency             String      @default("GBP")
  duration             Int
  includedServices     String
  eventType            String?
  cuisineType          String?
  maxGuests            Int?
  minGuests            Int?
  serviceType          String      @default("DINING")
  offersCookingClasses Boolean     @default(false)
  classType            String?
  pricePerStudent      Float?
  difficulty           String      @default("EASY")
  tags                 String?
  experienceImage      String?
  chefId               String
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  bookings             Booking[]
  chef                 ChefProfile @relation(fields: [chefId], references: [id])

  @@index([title])
  @@index([price])
  @@index([chefId])
  @@index([createdAt])
  @@index([isActive])
  @@index([cuisineType])
  @@index([eventType])
  @@index([difficulty])
  @@index([isActive, createdAt])
}

model Request {
  id                     String                @id @default(cuid())
  clientId               String
  title                  String?
  eventType              String
  requestMode            String                @default("STANDARD")
  serviceType            String?
  serviceTypeLabel       String?
  serviceTypeVersion     String?
  serviceTier            String?
  cuisineTypes           String?
  dietaryRequirements    String?
  serviceSpecificAnswers String?
  pricingRuleVersion     String?
  pricingRuleId          String?
  pricingStatus          String                @default("LOCAL_QUOTE_REQUIRED")
  budgetStatus           String                @default("UNASSESSED")
  budgetWarning          String?
  description            String?
  eventDate              DateTime
  eventDates             String?
  eventTime              String?
  location               String
  countryCode            String                @default("GB")
  currency               String                @default("GBP")
  guestCount             Int
  adultCount             Int?
  studentCount           Int?
  childrenUnder10        Int?
  actualAttendeeCount    Int?
  billableGuestCount     Float?
  pricingGuestCount      Float?
  latitude               Float?
  longitude              Float?
  locationCity           String?
  locationRegion         String?
  formattedAddress       String?
  geocodingProvider      String?
  geocodingStatus        String                @default("UNVERIFIED")
  budget                 Float
  budgetMode             String?
  totalBudget            Float?
  defaultDailyBudget     Float?
  details                String?
  createdAt              DateTime              @default(now())
  pricingRule            ServicePricingRule?   @relation(fields: [pricingRuleId], references: [id])
  proposals              Proposal[]
  client                 User                  @relation("ClientRequests", fields: [clientId], references: [id])
  invitations            RequestInvitation[]
  multiDayDates          MultiDayRequestDate[]
  photos                 RequestPhoto[]

  @@index([serviceType])
  @@index([requestMode])
  @@index([pricingRuleId])
  @@index([pricingStatus])
  @@index([budgetStatus])
}

model RequestPhoto {
  id           String   @id @default(cuid())
  requestId    String
  uploaderId   String
  url          String
  publicId     String?
  originalName String?
  contentType  String?
  sizeBytes    Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader     User     @relation("RequestPhotoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([requestId, sortOrder])
  @@index([uploaderId])
}

model ServicePricingRule {
  id                  String    @id @default(cuid())
  serviceType         String
  countryCode         String
  currency            String
  tier                String?
  minGuests           Int?
  maxGuests           Int?
  minimumSpend        Float?
  pricePerPersonMin   Float?
  pricePerPersonMax   Float?
  customerGuidance    String?
  warningCopy         String?
  evidenceSource      String?
  evidenceNotes       String?
  status              String    @default("DRAFT")
  version             String
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?
  reviewedBy          String?
  reviewedAt          DateTime?
  activatedBy         String?
  activatedAt         DateTime?
  retiredBy           String?
  retiredAt           DateTime?
  lifecycleReason     String?
  childrenRuleSummary String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  requests            Request[]

  @@index([serviceType, countryCode, currency, status])
  @@index([status, effectiveFrom])
  @@index([version])
}

model MarketConfiguration {
  id                               String   @id @default(cuid())
  countryCode                      String   @unique
  countryName                      String
  currency                         String
  supported                        Boolean  @default(true)
  active                           Boolean  @default(false)
  bookingEnabled                   Boolean  @default(false)
  paymentsEnabled                  Boolean  @default(false)
  legalEnabled                     Boolean  @default(false)
  platformCommissionRate           Float    @default(0.2)
  serviceChargeTaxRate             Float?
  serviceChargeTaxStatus           String   @default("NOT_CONFIGURED")
  serviceChargeTaxDeductionEnabled Boolean  @default(false)
  activationPrerequisites          String?
  internalNotes                    String?
  updatedBy                        String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@index([active])
  @@index([bookingEnabled])
  @@index([paymentsEnabled])
}

model LegalDocumentVersion {
  id            String                @id @default(cuid())
  documentType  String
  countryCode   String?
  version       String
  status        String                @default("DRAFT")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  sourceName    String?
  checksum      String?
  notes         String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  acceptances   UserLegalAcceptance[]

  @@unique([documentType, countryCode, version])
  @@index([documentType, countryCode, status])
}

model UserLegalAcceptance {
  id                String               @id @default(cuid())
  userId            String
  documentVersionId String
  role              String
  countryCode       String?
  acceptedVia       String
  acceptedAt        DateTime             @default(now())
  ipAddress         String?
  userAgent         String?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentVersion   LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, documentVersionId])
  @@index([userId, role, countryCode])
  @@index([documentVersionId])
}

model ServiceAsset {
  id               String   @id @default(cuid())
  serviceType      String
  imageUrl         String
  altText          String
  source           String?
  photographer     String?
  licence          String?
  licenceUrl       String?
  suppliedByClient Boolean  @default(false)
  clientApproved   Boolean  @default(false)
  usageLocations   String?
  status           String   @default("ACTIVE")
  internalNotes    String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([serviceType])
  @@index([status])
  @@index([clientApproved])
}

model MultiDayRequestDate {
  id                     String   @id @default(cuid())
  requestId              String
  date                   DateTime
  startTime              String?
  endTime                String?
  serviceType            String?
  serviceTypeLabel       String?
  serviceTier            String?
  cuisineTypes           String?
  dietaryRequirements    String?
  serviceSpecificAnswers String?
  adultCount             Int?
  childrenUnder10        Int?
  actualAttendeeCount    Int?
  billableGuestCount     Float?
  pricingGuestCount      Float?
  budget                 Float?
  notes                  String?
  serviceNeeds           String?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  request                Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, date])
  @@index([date])
  @@index([requestId, sortOrder])
}

model RequestInvitation {
  id        String      @id @default(cuid())
  requestId String
  chefId    String
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  chef      ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, chefId])
}

model Proposal {
  id          String             @id @default(cuid())
  requestId   String
  chefId      String
  menuId      String?
  price       Float
  currency    String             @default("GBP")
  message     String?
  status      String             @default("PENDING")
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  booking     Booking?
  paymentPlan PaymentPlan?
  chef        ChefProfile        @relation(fields: [chefId], references: [id])
  lineItems   ProposalLineItem[]
  menu        Menu?              @relation(fields: [menuId], references: [id])
  request     Request            @relation(fields: [requestId], references: [id])

  @@unique([chefId, requestId])
}

model ProposalLineItem {
  id          String    @id @default(cuid())
  proposalId  String
  serviceDate DateTime?
  title       String
  description String?
  price       Float
  currency    String    @default("GBP")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
  @@index([serviceDate])
}

model Booking {
  id                         String                    @id @default(cuid())
  clientId                   String
  chefId                     String
  proposalId                 String?                   @unique
  experienceId               String?
  eventDate                  DateTime
  location                   String
  latitude                   Float?
  longitude                  Float?
  guestCount                 Int
  adultCount                 Int?
  childrenUnder10            Int?
  actualAttendeeCount        Int?
  billableGuestCount         Float?
  pricingGuestCount          Float?
  studentCount               Int?
  totalPrice                 Float
  currency                   String                    @default("GBP")
  bookingType                String                    @default("PROPOSAL")
  serviceType                String?
  serviceTypeLabel           String?
  pricingRuleVersion         String?
  status                     String                    @default("PENDING")
  operationalStatus          String                    @default("NOT_STARTED")
  operationalStatusUpdatedAt DateTime?
  operationalStatusUpdatedBy String?
  operationalNotes           String?
  specialRequests            String?
  idempotencyKey             String?                   @unique
  version                    Int                       @default(1)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  chef                       ChefProfile               @relation("ChefBookings", fields: [chefId], references: [id])
  client                     User                      @relation("ClientBookings", fields: [clientId], references: [id])
  experience                 Experience?               @relation(fields: [experienceId], references: [id])
  proposal                   Proposal?                 @relation(fields: [proposalId], references: [id])
  disputes                   Dispute[]
  ledgerEntries              Ledger[]
  payments                   Payment?
  paymentPlan                PaymentPlan?
  pricingSnapshot            AcceptedPricingSnapshot?
  guestAmendments            BookingGuestAmendment[]
  review                     Review?
  serviceDates               BookingServiceDate[]
  insuranceCoverage          BookingInsuranceCoverage?

  @@index([status])
  @@index([operationalStatus])
  @@index([clientId, status])
  @@index([chefId, status])
  @@index([eventDate])
  @@index([idempotencyKey])
}

model BookingServiceDate {
  id                  String   @id @default(cuid())
  bookingId           String
  date                DateTime
  startTime           String?
  endTime             String?
  serviceType         String?
  serviceTypeLabel    String?
  cuisineTypes        String?
  dietaryRequirements String?
  adultCount          Int?
  childrenUnder10     Int?
  actualAttendeeCount Int?
  billableGuestCount  Float?
  pricingGuestCount   Float?
  notes               String?
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, date])
  @@index([date])
  @@index([bookingId, sortOrder])
}

model PlatformInsurancePolicy {
  id                 String                     @id @default(cuid())
  policyVersion      String                     @unique
  coverageType       String                     @default("PUBLIC_LIABILITY")
  coverageLimitMinor Int
  currency           String                     @default("GBP")
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  status             String                     @default("ACTIVE")
  internalReference  String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  bookingCoverages   BookingInsuranceCoverage[]

  @@index([status])
  @@index([coverageType, status])
}

model BookingInsuranceCoverage {
  id                  String                   @id @default(cuid())
  bookingId           String                   @unique
  chefId              String
  platformPolicyId    String?
  policyVersion       String
  coverageType        String                   @default("PUBLIC_LIABILITY")
  coverageLimitMinor  Int
  currency            String                   @default("GBP")
  coverageStatus      String                   @default("QUALIFIED")
  coverageStartAt     DateTime
  coverageEndAt       DateTime
  qualifiedAt         DateTime                 @default(now())
  qualificationBasis  String
  serviceDateSnapshot Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  booking             Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  chef                ChefProfile              @relation(fields: [chefId], references: [id], onDelete: Restrict)
  platformPolicy      PlatformInsurancePolicy? @relation(fields: [platformPolicyId], references: [id], onDelete: SetNull)

  @@index([chefId])
  @@index([coverageStatus])
  @@index([coverageStartAt])
  @@index([platformPolicyId])
}

model FullTimeChefEnquiry {
  id                    String    @id @default(cuid())
  clientId              String
  location              String
  countryCode           String    @default("GB")
  currency              String    @default("GBP")
  desiredStartDate      DateTime
  expectedDuration      String
  placementType         String
  liveInPreference      String
  workingDays           String
  workingHours          String
  householdSize         Int?
  adultCount            Int?
  childrenUnder10       Int?
  responsibilities      String?
  cuisineTypes          String?
  dietaryRequirements   String?
  budgetAmount          Float?
  budgetPeriod          String?
  travelRequirements    String?
  legalWorkRequirements String?
  notes                 String?
  assignedTo            String?
  internalNotes         String?
  qualifiedAt           DateTime?
  closedAt              DateTime?
  closedReason          String?
  status                String    @default("NEW")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  client                User      @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
  @@index([countryCode])
  @@index([assignedTo])
}

model BackgroundCheck {
  id                String      @id @default(cuid())
  chefId            String
  checkType         String
  provider          String?
  reference         String?
  status            String      @default("NOT_STARTED")
  submittedAt       DateTime?
  reviewerId        String?
  reviewedAt        DateTime?
  expiresAt         DateTime?
  recheckAt         DateTime?
  internalNotes     String?
  requestedUpdateAt DateTime?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  chef              ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)

  @@index([chefId])
  @@index([status])
  @@index([checkType])
  @@index([expiresAt])
}

model SupportTicket {
  id                String                 @id @default(cuid())
  requesterId       String?
  requesterRole     String?
  requesterEmail    String?
  category          String
  priority          String                 @default("NORMAL")
  status            String                 @default("OPEN")
  assignedTo        String?
  relatedRequestId  String?
  relatedBookingId  String?
  relatedPaymentId  String?
  subject           String
  description       String
  resolution        String?
  satisfactionScore Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  resolvedAt        DateTime?
  messages          SupportTicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([requesterId])
  @@index([createdAt])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String?
  senderRole String?
  message    String
  internal   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model Invoice {
  id             String    @id @default(cuid())
  bookingId      String?
  paymentId      String?
  invoiceNumber  String    @unique
  currency       String    @default("GBP")
  subtotalAmount Float     @default(0)
  taxAmount      Float     @default(0)
  totalAmount    Float     @default(0)
  status         String    @default("DRAFT")
  recipientName  String?
  recipientEmail String?
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  internalNotes  String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
}

model Payment {
  id                               String    @id @default(cuid())
  bookingId                        String    @unique
  totalAmount                      Float     @default(0)
  commissionAmount                 Float     @default(0)
  chefAmount                       Float     @default(0)
  platformCommissionRate           Float?
  serviceChargeTaxRate             Float?
  serviceChargeTaxAmount           Float     @default(0)
  serviceChargeTaxDeductionEnabled Boolean   @default(false)
  totalPlatformDeduction           Float?
  taxJurisdiction                  String?
  serviceChargeTaxStatus           String?
  currency                         String    @default("GBP")
  status                           String    @default("HELD")
  stripePaymentIntentId            String?   @unique
  stripeChargeId                   String?   @unique
  stripeCheckoutSessionId          String?   @unique
  idempotencyKey                   String?   @unique
  releasedAt                       DateTime?
  releasedBy                       String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  version                          Int       @default(1)
  ledgerEntries                    Ledger[]
  booking                          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refunds                          Refund[]

  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([idempotencyKey])
}

model PaymentPlan {
  id                     String                  @id @default(cuid())
  proposalId             String                  @unique
  bookingId              String?                 @unique
  planType               String
  status                 String                  @default("PENDING")
  totalAmountMinor       Int
  paidAmountMinor        Int                     @default(0)
  outstandingAmountMinor Int
  currency               String                  @default("GBP")
  eventAnchorDate        DateTime
  deadlineAt             DateTime?
  balanceDueAt           DateTime?
  stripeCustomerId       String?
  defaultPaymentMethodId String?
  futureUseConsentAt     DateTime?
  depositBasisPoints     Int?
  guarantorUserId        String?
  guarantorAcceptedAt    DateTime?
  recoveryStatus         String?
  recoveryStartedAt      DateTime?
  supportEscalatedAt     DateTime?
  nextRetryAt            DateTime?
  graceEndsAt            DateTime?
  shortfallAmountMinor   Int                     @default(0)
  shortfallChargedAt     DateTime?
  shortfallFailedAt      DateTime?
  lastFailureCode        String?
  lastFailureMessage     String?
  createdBy              String
  idempotencyKey         String?                 @unique
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  booking                Booking?                @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  proposal               Proposal                @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  installments           PaymentInstallment[]
  splitShares            SplitBillShare[]
  guestAmendments        BookingGuestAmendment[]

  @@index([planType])
  @@index([status])
  @@index([eventAnchorDate])
  @@index([balanceDueAt])
  @@index([deadlineAt])
  @@index([guarantorUserId])
  @@index([recoveryStatus])
}

model PaymentInstallment {
  id                      String          @id @default(cuid())
  paymentPlanId           String
  kind                    String
  status                  String          @default("PENDING")
  amountMinor             Int
  currency                String          @default("GBP")
  dueAt                   DateTime?
  paidAt                  DateTime?
  failedAt                DateTime?
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?         @unique
  stripeSetupIntentId     String?
  attemptCount            Int             @default(0)
  lastAttemptAt           DateTime?
  nextAttemptAt           DateTime?
  failureCode             String?
  failureMessage          String?
  idempotencyKey          String          @unique
  metadata                Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  paymentPlan             PaymentPlan     @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  splitShare              SplitBillShare?

  @@index([paymentPlanId, kind])
  @@index([status])
  @@index([dueAt])
  @@index([nextAttemptAt])
  @@index([stripePaymentIntentId])
}

model SplitBillShare {
  id                      String              @id @default(cuid())
  paymentPlanId           String
  installmentId           String?             @unique
  payerName               String?
  payerEmail              String?
  tokenHash               String              @unique
  tokenExpiresAt          DateTime
  status                  String              @default("PENDING")
  amountMinor             Int
  currency                String              @default("GBP")
  deadlineAt              DateTime
  paidAt                  DateTime?
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?             @unique
  refundState             String?
  idempotencyKey          String              @unique
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  installment             PaymentInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  paymentPlan             PaymentPlan         @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId, status])
  @@index([deadlineAt])
  @@index([payerEmail])
}

model AcceptedPricingSnapshot {
  id                          String   @id @default(cuid())
  bookingId                   String   @unique
  proposalId                  String
  requestId                   String
  originalAdultCount          Int?
  originalChildrenUnder10     Int?
  originalGuestCount          Int
  originalActualAttendeeCount Int?
  originalBillableGuestCount  Float?
  originalPricingGuestCount   Float?
  acceptedTotalMinor          Int
  currency                    String   @default("GBP")
  minimumSpendMinor           Int?
  perPersonAmountMinor        Int?
  pricingBasis                String
  pricingRuleVersion          String?
  commissionRate              Float
  serviceContext              Json?
  serviceDates                Json?
  createdAt                   DateTime @default(now())
  booking                     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([requestId])
  @@index([pricingBasis])
}

model BookingGuestAmendment {
  id                       String       @id @default(cuid())
  bookingId                String
  paymentPlanId            String?
  requesterId              String
  requesterRole            String
  amendmentType            String
  previousAdultCount       Int?
  previousChildrenUnder10  Int?
  previousGuestCount       Int
  requestedAdultCount      Int?
  requestedChildrenUnder10 Int?
  requestedGuestCount      Int
  addedAdultCount          Int          @default(0)
  addedChildrenUnder10     Int          @default(0)
  removedAdultCount        Int          @default(0)
  removedChildrenUnder10   Int          @default(0)
  reductionPercent         Float?
  pricingBasis             String?
  incrementalAmountMinor   Int          @default(0)
  refundAmountMinor        Int?
  currency                 String       @default("GBP")
  status                   String       @default("REQUESTED")
  stripeCheckoutSessionId  String?      @unique
  stripePaymentIntentId    String?      @unique
  refundId                 String?
  idempotencyKey           String       @unique
  adminNotes               String?
  chefReviewNotes          String?
  chefDecisionAt           DateTime?
  chefDecisionBy           String?
  clientAcceptedAt         DateTime?
  requestedAt              DateTime     @default(now())
  finalizedAt              DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  booking                  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentPlan              PaymentPlan? @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  requester                User         @relation("GuestAmendmentRequester", fields: [requesterId], references: [id])

  @@index([bookingId, status])
  @@index([paymentPlanId])
  @@index([requesterId])
  @@index([amendmentType])
  @@index([stripePaymentIntentId])
}

model Review {
  id        String      @id @default(cuid())
  rating    Int
  comment   String?
  clientId  String
  chefId    String
  bookingId String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  booking   Booking     @relation(fields: [bookingId], references: [id])
  chef      ChefProfile @relation(fields: [chefId], references: [id])
  client    User        @relation("ClientReviews", fields: [clientId], references: [id])
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  type           String
  message        String
  isRead         Boolean   @default(false)
  deliveryOnly   Boolean   @default(false)
  deliveryStatus String    @default("PENDING")
  deliverySentAt DateTime?
  deliveryError  String?
  dedupeKey      String?   @unique
  requestId      String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([deliveryOnly])
}

model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  emailMessages Boolean  @default(true)
  emailBookings Boolean  @default(true)
  emailRequests Boolean  @default(true)
  pushMessages  Boolean  @default(true)
  pushBookings  Boolean  @default(true)
  inAppMessages Boolean  @default(true)
  inAppBookings Boolean  @default(true)
  inAppRequests Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  bookingId  String?
  offerId    String?
  proposalId String?
  isRead     Boolean  @default(false)
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
}

model ModerationFlag {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  fieldName     String?
  violationType String
  excerpt       String?
  status        String   @default("OPEN")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([status])
  @@index([violationType])
}

model Availability {
  id               String      @id @default(cuid())
  chefId           String
  date             DateTime
  startTime        String
  endTime          String
  isAvailable      Boolean     @default(true)
  recurringPattern String?
  maxBookings      Int         @default(1)
  currentBookings  Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  chef             ChefProfile @relation(fields: [chefId], references: [id])
}

model Payout {
  id                String      @id @default(cuid())
  chefId            String
  amount            Float
  currency          String      @default("GBP")
  status            String      @default("PENDING")
  stripeTransferId  String?     @unique
  externalReference String?
  adminNotes        String?
  failureReason     String?
  approvedAt        DateTime?
  approvedBy        String?
  processedAt       DateTime?
  processedBy       String?
  cancelledAt       DateTime?
  cancelledBy       String?
  idempotencyKey    String?     @unique
  version           Int         @default(1)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  ledgerEntries     Ledger[]
  chef              ChefProfile @relation(fields: [chefId], references: [id])

  @@index([status])
  @@index([chefId, status])
}

model Refund {
  id                             String    @id @default(cuid())
  paymentId                      String
  amount                         Float
  currency                       String?
  reason                         String
  description                    String
  status                         String    @default("PENDING")
  processedBy                    String?
  stripeRefundId                 String?   @unique
  originalGrossAmount            Float?
  originalCommissionAmount       Float?
  originalServiceChargeTaxAmount Float?
  originalTotalPlatformDeduction Float?
  originalChefAmount             Float?
  originalServiceChargeTaxStatus String?
  createdAt                      DateTime  @default(now())
  processedAt                    DateTime?
  failureReason                  String?
  idempotencyKey                 String?   @unique
  ledgerEntries                  Ledger[]
  payment                        Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@index([stripeRefundId])
  @@index([createdAt])
}

model Dispute {
  id                 String    @id @default(cuid())
  bookingId          String
  reason             String
  description        String
  status             String    @default("OPEN")
  assignedTo         String?
  investigationState String?
  internalNotes      String?
  evidence           String?
  initiatedBy        String
  resolvedBy         String?
  resolution         String?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([assignedTo])
  @@index([initiatedBy])
  @@index([createdAt])
}

model WebhookLog {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  eventType     String
  status        String    @default("PENDING")
  payload       String
  processedAt   DateTime?
  errorMessage  String?
  retryCount    Int       @default(0)
  nextRetryAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([stripeEventId])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
  @@index([retryCount])
}

model Ledger {
  id              String   @id @default(cuid())
  transactionType String
  amount          Float
  currency        String   @default("GBP")
  bookingId       String?
  paymentId       String?
  refundId        String?
  payoutId        String?
  fromAccount     String?
  toAccount       String?
  description     String
  metadata        String?
  createdBy       String
  createdAt       DateTime @default(now())
  booking         Booking? @relation(fields: [bookingId], references: [id])
  payment         Payment? @relation(fields: [paymentId], references: [id])
  payout          Payout?  @relation(fields: [payoutId], references: [id])
  refund          Refund?  @relation(fields: [refundId], references: [id])

  @@unique([transactionType, payoutId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([bookingId])
  @@index([paymentId])
  @@index([refundId])
  @@index([payoutId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  oldValue    String?
  newValue    String
  performedBy String
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}

model SlotLock {
  id             String   @id @default(cuid())
  availabilityId String
  acquiredAt     DateTime @default(now())
  expiresAt      DateTime
  lockType       String   @default("BOOKING")

  @@unique([availabilityId, lockType])
  @@index([availabilityId])
  @@index([expiresAt])
}

model EventQueue {
  id           String    @id @default(cuid())
  eventType    String
  payload      String
  status       String    @default("PENDING")
  priority     Int       @default(0)
  retryCount   Int       @default(0)
  maxRetries   Int       @default(3)
  nextRetryAt  DateTime?
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([nextRetryAt])
  @@index([priority])
}

model ChefKpiSnapshot {
  id                   String      @id @default(cuid())
  chefId               String
  date                 DateTime
  quotesSent           Int         @default(0)
  proposalsAccepted    Int         @default(0)
  proposalsRejected    Int         @default(0)
  bookingsCompleted    Int         @default(0)
  messageResponseRate  Float       @default(0)
  proposalResponseRate Float       @default(0)
  earnings             Float       @default(0)
  menusCount           Int         @default(0)
  createdAt            DateTime    @default(now())
  chef                 ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)

  @@unique([chefId, date])
  @@index([chefId])
  @@index([date])
  @@index([chefId, date])
}
