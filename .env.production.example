# Production Environment Variables for Render
# Copy these to Render's Environment Variables dashboard

# Database (Render PostgreSQL)
# Render will provide this automatically: DATABASE_URL
# Format: postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=20&connect_timeout=10
# Note: Connection pool parameters are automatically added by lib/prisma.ts if not present
# If the web service cannot reach Render's private DATABASE_URL host, set DATABASE_PUBLIC_URL
# to the external/public Render PostgreSQL URL. The app will prefer DATABASE_PUBLIC_URL over DATABASE_URL.
DATABASE_PUBLIC_URL=<exact-render-external-postgres-url-if-private-url-is-unreachable>
EXTERNAL_DATABASE_URL=<exact-render-external-postgres-url-if-private-url-is-unreachable>
DIRECT_DATABASE_URL=<optional-direct-postgres-url>

# NextAuth (Production)
NEXTAUTH_URL=https://chefachef.co.uk
NEXT_PUBLIC_BASE_URL=https://chefachef.co.uk
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Stripe
# Use TEST keys for staging QA. Use LIVE keys only after test-mode QA and client signoff.
STRIPE_SECRET_KEY=<stripe-secret-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

# Cron endpoints
CRON_SECRET=<generate-a-long-random-secret>

# Redis / Upstash
# Production checkout and availability locks require a distributed Redis provider.
UPSTASH_REDIS_REST_URL=<upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
# OR
REDIS_URL=<redis-url>

# Durable Image Storage
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# API Configuration
API_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (Production)
CORS_ORIGIN=https://chefachef.co.uk
ALLOWED_ORIGINS=https://chefachef.co.uk,https://www.chefachef.co.uk

# Sentry (Optional - Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Email Service (Resend)
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=ChefaChef <info@chefachef.com>

# Chef KPI Targets
CHEF_QUOTES_TARGET=10
CHEF_MENUS_TARGET=5
