# Production Environment Variables for Render
# Copy these to Render's Environment Variables dashboard

# Database (Render PostgreSQL)
# Render will provide this automatically: DATABASE_URL
# Format: postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=20&connect_timeout=10
# Note: Connection pool parameters are automatically added by lib/prisma.ts if not present
# If the web service cannot reach Render's private DATABASE_URL host, set DATABASE_PUBLIC_URL
# to the external/public Render PostgreSQL URL. The app will prefer DATABASE_PUBLIC_URL over DATABASE_URL.
DATABASE_PUBLIC_URL=<exact-render-external-postgres-url-if-private-url-is-unreachable>
EXTERNAL_DATABASE_URL=<exact-render-external-postgres-url-if-private-url-is-unreachable>
DIRECT_DATABASE_URL=<optional-direct-postgres-url>

# NextAuth (Production)
NEXTAUTH_URL=https://chef-management.onrender.com
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Stripe (Production - Use LIVE keys)
# IMPORTANT: Get these from your Stripe Dashboard → Developers → API keys
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Redis (Optional - Render Redis)
REDIS_URL=<render-redis-url-if-used>

# API Configuration
API_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (Production)
CORS_ORIGIN=https://chef-management.onrender.com
ALLOWED_ORIGINS=https://chef-management.onrender.com

# Sentry (Optional - Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Email Service (Optional - SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@chef-management.onrender.com

# Chef KPI Targets
CHEF_QUOTES_TARGET=10
CHEF_MENUS_TARGET=5
