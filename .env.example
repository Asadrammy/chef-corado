# Database
# Local development with PostgreSQL (required for production compatibility):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chef_marketplace"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chef_marketplace_test"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# To run PostgreSQL locally, use Docker:
# docker run --name chef-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=chef_marketplace -p 5432:5432 -d postgres:15

# Production (Render/other managed PostgreSQL):
# Render automatically provides DATABASE_URL environment variable
# Format: postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=20&connect_timeout=10
# If the deployed web service cannot reach Render's private DATABASE_URL host, set DATABASE_PUBLIC_URL
# to the external/public Render PostgreSQL URL instead. RENDER_POSTGRES_REGION is used only when
# DATABASE_URL contains a bare Render private hostname such as dpg-xxxx-a.
DATABASE_PUBLIC_URL=""
DIRECT_DATABASE_URL=""
RENDER_POSTGRES_REGION="singapore"

# NextAuth
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Logging Service (Choose one)
LOGTAIL_TOKEN="your-logtail-token"
# OR
DATADOG_API_KEY="your-datadog-api-key"

# Stripe (Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Geocoding (Radius Matching)
# Server-side Google Geocoding API key. Do not use browser-restricted keys here.
GOOGLE_GEOCODING_API_KEY="your-server-side-google-geocoding-key"
# Optional legacy alias supported by the app:
GOOGLE_MAPS_API_KEY="your-server-side-google-maps-key"

# AWS S3 (File Storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_CERTIFICATE_PREFIX="private/certificates"

# Email Service (SendGrid or similar)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# Public Contact & Social Configuration
# Leave empty until the client has approved real public contact channels.
NEXT_PUBLIC_CONTACT_WHATSAPP_URL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=""
NEXT_PUBLIC_SOCIAL_X_URL=""
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=""

# Redis (Optional - for caching)
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV="production"
ENVIRONMENT="production"

# API Configuration
API_TIMEOUT_MS="30000"
MAX_REQUEST_SIZE="10mb"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Security
CORS_ORIGIN="https://yourdomain.com"
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Backup Configuration
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
BACKUP_STORAGE="s3"
BACKUP_S3_BUCKET="your-backup-bucket"

# Monitoring
HEALTH_CHECK_ENABLED="true"
METRICS_ENABLED="true"

# Chef KPI Targets (Configurable - defaults shown)
CHEF_QUOTES_TARGET="10"
CHEF_MENUS_TARGET="5"
