# Database
# Local development with PostgreSQL (required for production compatibility):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chef_marketplace"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chef_marketplace_test"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# To run PostgreSQL locally, use Docker:
# docker run --name chef-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=chef_marketplace -p 5432:5432 -d postgres:15

# Production (Render/other managed PostgreSQL):
# Render automatically provides DATABASE_URL environment variable
# Format: postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=20&connect_timeout=10
# If the deployed web service cannot reach Render's private DATABASE_URL host, set DATABASE_PUBLIC_URL
# to the exact External Database URL from the Render PostgreSQL Connect tab.
DATABASE_PUBLIC_URL=""
EXTERNAL_DATABASE_URL=""
DIRECT_DATABASE_URL=""

# NextAuth
NEXTAUTH_URL="https://chefachef.co.uk"
NEXT_PUBLIC_BASE_URL="https://chefachef.co.uk"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Logging Service (Choose one)
LOGTAIL_TOKEN="your-logtail-token"
# OR
DATADOG_API_KEY="your-datadog-api-key"

# Stripe (Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<stripe-publishable-key>"
STRIPE_SECRET_KEY="<stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"

# Cron endpoints
CRON_SECRET="<generate-a-long-random-secret>"

# Geocoding (Radius Matching)
# Server-side Google Geocoding API key. Do not use browser-restricted keys here.
GOOGLE_GEOCODING_API_KEY="your-server-side-google-geocoding-key"
# Optional legacy alias supported by the app:
GOOGLE_MAPS_API_KEY="your-server-side-google-maps-key"

# AWS S3 (File Storage)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_BUCKET="your-bucket-name"
AWS_S3_CERTIFICATE_PREFIX="private/certificates"

# Email Service (Resend)
RESEND_API_KEY="<resend-api-key>"
RESEND_FROM_EMAIL="ChefaChef <info@chefachef.co.uk>"

# Durable Image Storage
# Production must use durable storage. Local development may omit this and use the local fallback.
IMAGE_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"

# Public Contact & Social Configuration
# Leave empty until the client has approved real public contact channels.
NEXT_PUBLIC_CONTACT_WHATSAPP_URL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=""
NEXT_PUBLIC_SOCIAL_X_URL=""
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=""
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=""

# Redis / Upstash
# Production checkout and availability locks require a distributed Redis provider.
UPSTASH_REDIS_REST_URL="<upstash-rest-url>"
UPSTASH_REDIS_REST_TOKEN="<upstash-rest-token>"
# OR
REDIS_URL="redis://localhost:6379"

# Environment
NODE_ENV="production"
ENVIRONMENT="production"

# API Configuration
API_TIMEOUT_MS="30000"
MAX_REQUEST_SIZE="10mb"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Security
CORS_ORIGIN="https://chefachef.co.uk"
ALLOWED_ORIGINS="https://chefachef.co.uk,https://www.chefachef.co.uk"

# Backup Configuration
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
BACKUP_STORAGE="s3"
BACKUP_S3_BUCKET="your-backup-bucket"

# Monitoring
HEALTH_CHECK_ENABLED="true"
METRICS_ENABLED="true"

# Chef KPI Targets (Configurable - defaults shown)
CHEF_QUOTES_TARGET="10"
CHEF_MENUS_TARGET="5"
